+        const csv = await (await x.request(statementPath(who.customer.id, 'csv') + `?asOf=${date}`, reader.who.cookie !== undefined ? { as: reader.who.cookie } : reader.who.headers ? { as: '', headers: reader.who.headers } : {})).text()
