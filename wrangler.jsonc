{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "field-service-glove",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "field-service-glove",
      "database_id": "local-field-service-glove-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "",
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": "",
    "MAIL_ACCOUNT_ID": "",
    "OWNER_EMAIL": "",
    "IDENTITY_PROVIDER": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MAIL_REJECTIONS",
        "class_name": "MailRejections"
      }
    ]
  },
  "migrations": [
    {
      "tag": "mail-rejections-v1",
      "new_sqlite_classes": [
        "MailRejections"
      ]
    }
  ]
}
